# Draw moves cursor to spot (tput, cup) and prints one space with a colored backround while \e[0m 
draw() { tput cup "$1" "$2"; printf '\e[%sm \e[0m' "$3"; }

# Free only works if the cell is on the screen and nobody has a trail at the point.
free() { 
        (( $1 >= 0 && $1 < H && $2 >= 0 && $2 < W )) && [[ -z ${wall["$1,$2"]} ]] 
    }


# Get that starting spot fresh for the idk spawning ig 1 is you -1 is dat nasty clanker.
