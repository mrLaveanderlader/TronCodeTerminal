# Color Menu type shit yeah... numbers or whatever
names=(Cyan Red White Yellow)
codes=(46 41 47 43)
...
for i in "${!names[@]}"; do 
    printf '  %d) \e[%sm  \e[0m %s\n' $(( i + 1 )) "${codes[i]}" "${names[i]}"
done
while true; do
    IFS= read -rsn1 -p "Enter 1-4: " choice
    echo
    [[ $choice =~ ^[1-4]$ ]] && break
done
pidx=$(( choice - 1 ))
aidx=$pidx
